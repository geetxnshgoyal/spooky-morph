<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the Windows projects restore and compile on macOS and Linux too; they still only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
    <Version>1.0.1</Version>
    <Product>Morph</Product>
    <Company>Morph</Company>
    <Description>Free, local-only file converter and toolbox</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
