<Project Sdk="Microsoft.NET.Sdk">

  <!-- Two builds of the engine: a portable one (runs the tests anywhere, including the Mac) and a Windows one
       that adds the WinRT pieces: OCR, face detection, PDF rendering, Media Foundation and the Recycle Bin. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;$(WindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Morph</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- PDFsharp pulls in 8.0.1, which has known advisories; Morph never signs PDFs, but pin the patched release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Morph.Core.Tests" />
  </ItemGroup>

  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <Compile Remove="Windows/**" />
  </ItemGroup>

</Project>
